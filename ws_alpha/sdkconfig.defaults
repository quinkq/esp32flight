# ws_alpha: Ai-Thinker ESP-C3-32S kit, 4 MB flash
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Two 1.5 MB OTA slots, rollback on (main/ota.c: a new firmware's first wake
# decides, see BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP below)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Signed firmware: an update is accepted only with a valid signature from our
# key, the same as the display's (RSA-3072). Without hardware secure boot, so
# no eFuses are burned: it keeps foreign firmware out over the air, whoever
# sends the offer. The key lives outside the repo (relative to this project
# directory); the build stops without it. The first signed build goes on by
# cable: an update is checked against the running firmware's key.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="../../secrets/firmware-signing-key.pem"

# The update (HTTP client, signature check) runs in the main task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Never used here, so out of the image: a smaller image downloads faster,
# i.e. less Wi-Fi time per update
# CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS is not set
# CONFIG_LWIP_IPV6 is not set

# Short wakes: no image check after deep sleep, a quiet bootloader
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# Console on UART0 only. The USB peripheral's D+ pull-up lights the kit's
# white LED on GPIO19, and its clock costs power. (The secondary console
# would switch the peripheral back on.)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_USJ_ENABLE_USB_SERIAL_JTAG is not set

# 1 ms ticks, so the short sensor waits are exact
CONFIG_FREERTOS_HZ=1000

# Console time is awake time (115200 baud, the CPU waits for the UART):
# ESP-IDF's own messages (boot, Wi-Fi driver) only from warnings up; the
# firmware's own modules raise themselves back to INFO in app_main.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

# The slow clock that keeps time in deep sleep. The default 136 kHz RC ran
# 0.76 % fast on the bench (11 min a day); the 17.5 MHz oscillator / 256 is
# steadier, for about 5 uA more while asleep.
CONFIG_RTC_CLK_SRC_INT_8MD256=y
