menu "ws_alpha"

    choice WS_ALPHA_INTERVAL
        prompt "Measurement interval until the display sets one"
        default WS_ALPHA_INTERVAL_900
        help
            From power-on to the display's first reply; after that the display
            decides (1 minute to 6 hours). Wakes are aligned to multiples of
            it. One minute is handy on the bench.

        config WS_ALPHA_INTERVAL_60
            bool "1 minute (bench)"
        config WS_ALPHA_INTERVAL_300
            bool "5 minutes"
        config WS_ALPHA_INTERVAL_900
            bool "15 minutes"
    endchoice

    config WS_ALPHA_INTERVAL_S
        int
        default 60 if WS_ALPHA_INTERVAL_60
        default 300 if WS_ALPHA_INTERVAL_300
        default 900

    config WS_ALPHA_TX_POWER_DBM
        int "Maximum transmit power, dBm"
        range 2 20
        default 20
        help
            Lower power means a lower current peak at each send, i.e. more
            margin against brownouts on a weak or cold cell. The display is
            4-10 m away; tune this down once the received signal strength
            (logged on both sides) is known.

endmenu
